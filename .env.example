# Backend Configuration
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=tracker
DB_PASSWORD=tracker_password
DB_NAME=tracker_v7
DB_SYNC=true
DB_LOGGING=true

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRATION=7d

# External APIs
COINGECKO_API_KEY=
ALCHEMY_API_KEY=
HELIUS_API_KEY=
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Notifications
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@tracker.local

# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Frontend
REACT_APP_API_URL=http://localhost:3000/api
REACT_APP_WEBSOCKET_URL=ws://localhost:3000

# Mobile
EXPO_PUBLIC_API_URL=http://localhost:3000/api
EXPO_PUBLIC_WEBSOCKET_URL=ws://localhost:3000
