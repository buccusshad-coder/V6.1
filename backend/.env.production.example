# Production Environment Variables
# Copy this file to .env.production and fill in your values

# Backend Server
NODE_ENV=production
PORT=3000

# Database (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=tracker_user
DB_PASSWORD=CHANGE_THIS_VERY_SECURE_PASSWORD
DB_NAME=tracker_v7_prod
DB_SYNC=true
DB_LOGGING=false

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT
JWT_SECRET=CHANGE_THIS_TO_VERY_LONG_RANDOM_SECRET_KEY_MINIMUM_32_CHARS
JWT_EXPIRATION=7d

# External APIs - Blockchain Data
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY
ETHERSCAN_ALT_API_KEY=YOUR_ALTERNATIVE_ETHERSCAN_KEY
ALCHEMY_API_KEY=YOUR_ALCHEMY_API_KEY
INFURA_API_KEY=YOUR_INFURA_API_KEY
HELIUS_API_KEY=YOUR_HELIUS_API_KEY
SOLANA_RPC_API_KEY=YOUR_SOLANA_RPC_KEY

# External APIs - Price Data
COINGECKO_API_KEY=YOUR_COINGECKO_API_KEY
COINMARKETCAP_API_KEY=YOUR_COINMARKETCAP_API_KEY

# CORS
CORS_ORIGIN=https://your-frontend-domain.com

# Frontend URLs
REACT_APP_API_URL=https://your-backend-domain.com/api
REACT_APP_WEBSOCKET_URL=wss://your-backend-domain.com

# Optional: Notification Services
DISCORD_WEBHOOK_URL=YOUR_DISCORD_WEBHOOK_URL
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID
SENDGRID_API_KEY=YOUR_SENDGRID_API_KEY
SENDGRID_FROM_EMAIL=noreply@your-domain.com

# Optional: Firebase
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_PRIVATE_KEY=YOUR_FIREBASE_PRIVATE_KEY
FIREBASE_CLIENT_EMAIL=YOUR_FIREBASE_CLIENT_EMAIL

# Mobile
EXPO_PUBLIC_API_URL=https://your-backend-domain.com/api
EXPO_PUBLIC_WEBSOCKET_URL=wss://your-backend-domain.com
